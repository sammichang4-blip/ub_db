const LYSINE_SITES = [6, 11, 27, 29, 33, 48, 63]; // 已知多泛素鏈接位點
const resultsList = document.getElementById("resultsList");
const detailPane = document.getElementById("detailPane");
const searchForm = document.getElementById("searchForm");
const searchInput = document.getElementById("searchInput");

let currentProteinId = null;
let pdbViewer = null;
let currentPdbId=null;
let currentData = null;
let currentProtein = null;
let currentPdbUrl = null;

// Cytoscape instance
let cy = null;

async function initViewer(){
    console.log("===== initViewer =====");
    const container = document.getElementById("pdb-viewer");
    console.log("container =", container);

    if (!container){
        return;
    }

    if (pdbViewer){
        return;
    }

    try {

        pdbViewer = await molstar.Viewer.create(
            "pdb-viewer",
            {
              layoutIsExpanded:false,
              layoutShowControls:false,
              collapseLeftPanel:true,
              collapseRightPanel:true
            }
        );

        console.log(
            "Mol* viewer ready",
            pdbViewer
        );

    } catch(error){

        console.error(
            "Mol* initialization error:",
            error
        );
    }
}

async function showPDBStructure(pdb_url){
    console.log("Loading:", pdb_url);
    // 保存目前實際的 PDB URL
    currentPdbUrl = pdb_url
    if(!pdbViewer){
        console.error("Mol* viewer not initialized");
        return;
    }
    // 清除目前 structure
    await pdbViewer.plugin.clear();
    const ext =
        pdb_url.toLowerCase().endsWith(".cif")
        ? "mmcif"
        : "pdb";
    try {
        const data =
            await pdbViewer.plugin.builders.data.download(
            {
                url:pdb_url,
                isBinary:false
            });
        console.log("Data:", data);
        const trajectory =
            await pdbViewer.plugin.builders.structure.parseTrajectory(
                data,
                ext
            );
        await pdbViewer.plugin.builders.structure.hierarchy.applyPreset(
            trajectory,
            "default"
        );
    }
    catch(err){
        console.error(
            "Load structure failed:",
            pdb_url,
            err
        );
    }
}

searchForm.addEventListener("submit", (e) => {
  e.preventDefault();
  doSearch(searchInput.value.trim());
});

async function doSearch(q) {
  console.log("q. :",q)

  if (!q) return;
  const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
  const data = await res.json();
  renderResults(data);

  if (data.length > 0) {
    loadProtein(data[0].protein_id);
  } else {
    detailPane.innerHTML = `<div class="empty-state"><p>找不到符合「${escapeHtml(q)}」的蛋白質。</p></div>`;
  }
}

function renderResults(items) {
  resultsList.innerHTML = "";
  items.forEach((item) => {
    
    const li = document.createElement("li");
    li.className = "result-item" + (item.protein_id === currentProteinId ? " active" : "");
    
    li.innerHTML = `<div class="gene">${escapeHtml(item.gene_name || item.uniprot_acc)}</div>
                    <div class="name">${escapeHtml(item.protein_name || "")}</div>`;

    li.addEventListener("click", () => loadProtein(item.protein_id));
    resultsList.appendChild(li);
    
  });
}

async function loadProtein(proteinId) {
  currentProteinId = proteinId;
  document.querySelectorAll(".result-item").forEach((el, i) => {
    el.classList.toggle("active", el.querySelector(".gene").textContent);
  });
  const res = await fetch(`/api/protein/${encodeURIComponent(proteinId)}`);

  if (!res.ok) {
    detailPane.innerHTML = `<div class="empty-state"><p>載入失敗。</p></div>`;
    return;
  }
  const data = await res.json();
  // 存起來，讓 openExpandedView() 之後能讀到
  currentData = data;
  currentProtein = data.protein;
  


  renderDetail(data);
  loadNetwork(data.protein.gene_name);

}

function destroyNetwork(){

    if(cy){
        cy.destroy();
        cy=null;
    }
}

function renderDescription(desc) {

    if (!desc) {
        return `<p style="color:var(--ink-dim)">No functional description.</p>`;
    }

    // 去掉 ECO annotation
    desc = desc.replace(/\{ECO:[^}]+\}/g, "");

    // 將多個空白壓成一個空白
    desc = desc.replace(/\s+/g, " ").trim();

    // 每個 Block 以最後一個 (PubMed:...) 為結束
    const blocks = desc.match(/.*?\(PubMed:[^)]+\)\./g) || [desc];

    let html = "";
    let index = 1;

    blocks.forEach(block => {

        // 找 PMID
        const pmids = [...block.matchAll(/PubMed:(\d+)/g)]
            .map(m => m[1]);

        // 移除 PMID
        let text = block
            .replace(/\(PubMed:[^)]+\)\./g, "")
            .trim();

        html += `
        <div class="function-card">

            <div class="function-title">
                <span class="function-index">${index}.</span>
                ${escapeHtml(text)}

                📚 
                ${
                    pmids.map(id =>
                        `<a href="https://pubmed.ncbi.nlm.nih.gov/${id}/"
                           target="_blank">
                           PMID:${id}
                         </a>`
                    ).join(",")
                }
            </div>

        </div>
        `;

        index++;
    });

    return html;
}

    

function showCopyMessage(msg){

    let box =
    document.querySelector(".copy-message");


    if(!box){

        box=document.createElement("div");

        box.className="copy-message";

        document.body.appendChild(box);

    }


    box.innerText=msg;

    box.style.opacity=1;


    setTimeout(()=>{

        box.style.opacity=0;

    },1500);

}

function loadProteinClass(enzymeClass){

fetch(`/api/enzyme/${enzymeClass}`)

.then(res=>res.json())

.then(data=>{


    const list =
    document.getElementById("resultsList");


    list.innerHTML="";


    document.querySelector(".pane-title")
    .innerHTML =
    `${enzymeClass} (${data.length})`;


    data.forEach(p=>{


        const li=document.createElement("li");

        li.className="result-item";


        li.innerHTML=`

        <div class="gene">
            ${escapeHtml(p.gene_name || "")}
        </div>

        <div class="name">
            ${escapeHtml(p.protein_name || "")}
        </div>

        <div class="name">
            ${escapeHtml(p.uniprot_acc || "")}
        </div>

        <div class="name">
            ${escapeHtml(p.enzyme_subfamily || "")}
        </div>

        `;


        li.onclick=function(){

            // 使用和 search 完全相同流程
            loadProtein(p.protein_id);

        };


        list.appendChild(li);


    });
});
}

function openExpandedView() {
    const p = currentProtein;
    const data = currentData;

    if (!p || !data) {
        console.error("尚未載入蛋白質資料");
        return;
    }

    const win = window.open(
        "",
        "_blank",
        "width=900,height=800,scrollbars=yes,resizable=yes"
    );

    if (!win) {
        alert("瀏覽器封鎖了彈出視窗，請允許彈出視窗後再試一次。");
        return;
    }

    // --------------------------------------------------
    // Paper date parser
    // 支援：
    //   paper.pub_date
    //   paper.publication_date
    //   paper.date
    //   paper.year
    // --------------------------------------------------
    function getPaperDate(paper) {
        const value =
            paper.pub_date ||
            paper.publication_date ||
            paper.date ||
            paper.year;

        if (!value) {
            return null;
        }

        // YYYY
        if (/^\d{4}$/.test(String(value))) {
            return new Date(
                Number(value),
                0,
                1
            );
        }

        const d = new Date(value);

        if (!isNaN(d.getTime())) {
            return d;
        }

        return null;
    }

    // --------------------------------------------------
    // Filter papers by years
    // --------------------------------------------------
    function filterPapersByYears(papers, years) {
        if (!Array.isArray(papers)) {
            return [];
        }

        const now = new Date();

        const startDate = new Date(now);
        startDate.setFullYear(
            now.getFullYear() - years
        );

        return papers.filter(paper => {
            const paperDate = getPaperDate(paper);

            // 沒有日期的 paper 不顯示
            if (!paperDate) {
                return false;
            }

            return paperDate >= startDate && paperDate <= now;
        });
    }

    // --------------------------------------------------
    // 依單一年份篩選 paper
    // --------------------------------------------------
    function filterPapersByYear(papers, year) {
        return papers.filter(function (paper) {
            // 依實際欄位調整，例如 paper.pub_year
            return Number(paper.pub_year) === Number(year);
        });
    }

    function updatePapersByYear(year) {
        const papers = filterPapersByYear(data.papers, year);

        const papersHtml = renderPapers(papers, { expandAll: true });

        const container = win.document.getElementById("papers-container");
        const count = win.document.getElementById("paper-count");

        if (container) {
            container.innerHTML = papersHtml;
        }

        if (count) {
            count.textContent = `${papers.length} 篇`;
        }
    }

    // --------------------------------------------------
    // Render filtered papers
    // --------------------------------------------------
    function updatePapers(years) {

        const papers = filterPapersByYears(
            data.papers,
            years
        );

        const papersHtml = renderPapers(
            papers,
            {
                expandAll: true
            }
        );

        const container =
            win.document.getElementById("papers-container");

        const count =
            win.document.getElementById("paper-count");

        if (container) {
            container.innerHTML = papersHtml;
        }

        if (count) {
            count.textContent =
                `${papers.length} 篇`;
        }
    }

    // 初始顯示 1 年
    const initialYears = 1;

    const initialPapers =
        filterPapersByYears(
            data.papers,
            initialYears
        );

    const papersHtml = renderPapers(
        initialPapers,
        {
            expandAll: true
        }
    );

    const descHtml =
        renderDescription(p.description);

    win.document.write(`
        <!DOCTYPE html>
        <html lang="zh-Hant">

        <head>
            <meta charset="UTF-8">

            <title>
                ${escapeHtml(p.protein_name)}
                (${escapeHtml(p.gene_name)})
                - 詳細資料
            </title>

            <style>

                body {
                    font-family:
                        -apple-system,
                        BlinkMacSystemFont,
                        "Noto Sans TC",
                        sans-serif;

                    max-width: 900px;
                    margin: 0 auto;
                    padding: 2em;

                    line-height: 1.6;
                    color: #222;
                    background: #fff;
                }

                h1 {
                    font-size: 1.4em;
                    margin-bottom: 0.3em;
                }

                h5 {
                    margin-top: 1.5em;
                    margin-bottom: 0.8em;
                }

                .function-card {
                    padding: 0.6em 0;
                    border-bottom: 1px solid #eee;
                }

                .function-index {
                    font-weight: 600;
                    margin-right: 0.4em;
                }

                a {
                    color: #2563eb;
                }


                /* ========================================
                   Paper filter
                ======================================== */

                .paper-filter {
                    margin: 15px 0 20px 0;

                    padding: 14px 18px;

                    background: #f7f7f7;

                    border: 1px solid #ddd;

                    border-radius: 8px;
                }

                .paper-filter-header {
                    display: flex;

                    justify-content:
                        space-between;

                    align-items: center;

                    margin-bottom: 8px;
                }

                .paper-filter-title {
                    font-weight: 600;
                }

                #paper-years-label {
                    font-weight: 600;
                    color: #2563eb;
                }

                #paper-count {
                    color: #777;
                    font-size: 0.9em;
                    margin-left: 8px;
                }

                #paper-years {
                    width: 100%;
                    cursor: pointer;
                }

                .year-scale {
                    display: flex;
                    justify-content:
                        space-between;

                    color: #777;

                    font-size: 0.8em;

                    margin-top: 3px;
                }

                .paper-empty {
                    padding: 20px;

                    text-align: center;

                    color: #888;

                    background: #fafafa;

                    border-radius: 6px;
                }

            </style>
        </head>


        <body>

            <h1>
                ${escapeHtml(p.protein_name)}

                <span
                    style="
                        font-weight:400;
                        color:#888;
                    "
                >
                    (${escapeHtml(p.gene_name)})
                </span>
            </h1>


            <p style="color:#888;">
                UniProt:
                ${escapeHtml(p.uniprot_acc)}
                ·
                ${escapeHtml(p.entry_name || "")}
                ·
                ${escapeHtml(p.organism)}
                ·
                ${p.length} aa
            </p>


            <h5>
                📄 相關論文（PubMed，近期）
            </h5>


            <!-- Paper year filter -->

            <div class="paper-filter">

                <div class="paper-filter-header">

                    <span class="paper-filter-title">
                        論文時間範圍
                    </span>

                    <span>
                        最近
                        <span id="paper-years-label">
                            1 年
                        </span>

                        <span id="paper-count">
                            ${initialPapers.length} 篇
                        </span>
                    </span>

                </div>


                <input
                    type="range"
                    id="paper-years"
                    min="1"
                    max="10"
                    step="1"
                    value="1"
                >


                <div class="year-scale">
                    <span>1 年</span>
                    <span>2 年</span>
                    <span>3 年</span>
                    <span>4 年</span>
                    <span>5 年</span>
                    <span>6 年</span>
                    <span>7 年</span>
                    <span>8 年</span>
                    <span>9 年</span>
                    <span>10 年</span>
                </div>

                <!-- 個別年度篩選 -->
                <div class="year-buttons">
                    <button class="year-btn" data-year="all">全部（依滑桿）</button>     依年份 ：
                    <button class="year-btn" data-year="2026">2026</button>
                    <button class="year-btn" data-year="2025">2025</button>
                    <button class="year-btn" data-year="2024">2024</button>
                    <button class="year-btn" data-year="2023">2023</button>
                    <button class="year-btn" data-year="2022">2022</button>
                    <button class="year-btn" data-year="2021">2021</button>
                    <button class="year-btn" data-year="2020">2020</button>
                    <button class="year-btn" data-year="2019">2019</button>
                    <button class="year-btn" data-year="2018">2018</button>
                    <button class="year-btn" data-year="2017">2017</button>
                    <button class="year-btn" data-year="2016">2016</button>

                </div>
        
            </div>

            <!-- Papers -->

            <div id="papers-container">
                ${papersHtml}
            </div>


            <h5 style="color:#888;">
                🗂 功能描述（UniProt，較舊）
            </h5>

            ${descHtml}


        </body>
        </html>
    `);

    win.document.close();


    // --------------------------------------------------
    // Slider event
    // --------------------------------------------------

    const slider =
        win.document.getElementById("paper-years");

    const yearLabel =
        win.document.getElementById(
            "paper-years-label"
        );


    if (slider) {

        slider.addEventListener(
            "input",
            function () {

                const years =
                    Number(this.value);

                // 更新文字
                if (yearLabel) {
                    yearLabel.textContent =
                        `${years} 年`;
                }

                // 更新 paper
                updatePapers(years);
            }
        );
    }
        // --------------------------------------------------
    // 年份按鈕事件
    // --------------------------------------------------
    const yearButtons =
        win.document.querySelectorAll(".year-btn");

    yearButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {

            // 切換 active 樣式
            yearButtons.forEach(function (b) {
                b.classList.remove("active");
            });
            btn.classList.add("active");

            const year = btn.dataset.year;

            if (year === "all") {
                // 回到滑桿模式
                if (slider) {
                    updatePapers(Number(slider.value));
                }
            } else {
                updatePapersByYear(year);
            }
        });
    });
}



function toggleMorePapers(btn) {
    const container = btn.closest(".scroll-box");
    const hiddenPapers = container.querySelectorAll(".paper-hidden");
    const isExpanded = btn.dataset.expanded === "true";

    hiddenPapers.forEach(el => {
        el.style.display = isExpanded ? "none" : "block";
    });

    btn.dataset.expanded = (!isExpanded).toString();
    btn.textContent = isExpanded
        ? `顯示更多（還有 ${hiddenPapers.length} 篇）`
        : `收起`;
}

function renderPapers(papers, options = {}) {

    if (!papers || papers.length === 0) {
        return `<p style="color:var(--ink-dim)">No recent papers found.</p>`;
    }

    const expandAll = options.expandAll === true;
    const VISIBLE_COUNT = 5;
    let html = "";

    papers.forEach((paper, i) => {
        const meta = [paper.journal, paper.pub_date || paper.pub_year]
            .filter(Boolean)
            .map(escapeHtml)
            .join(" · ");

        const hiddenClass = (!expandAll && i >= VISIBLE_COUNT) ? "paper-hidden" : "";

        html += `
        <div class="function-card paper-card ${hiddenClass}">
            <div class="function-title">
                <span class="function-index">${i + 1}.</span>
                <a href="https://pubmed.ncbi.nlm.nih.gov/${paper.pmid}/" target="_blank">
                    ${escapeHtml(paper.title)}
                </a>
                <div>
                <span style="color:var(--ink-dim); font-size:0.85em;">
                    * ${meta} · score: ${paper.relevance_score}
                    ${paper.matched_term ? ` · matched: ${escapeHtml(paper.matched_term)}` : ""}
                </span>
                </div>
            </div>
        </div>
        `;
    });

    if (!expandAll && papers.length > VISIBLE_COUNT) {
        html += `
        <button class="show-more-btn" onclick="toggleMorePapers(this)">
            顯示更多（還有 ${papers.length - VISIBLE_COUNT} 篇）
        </button>
        `;
    }

    return html;
}

